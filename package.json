{
  "name": "erd-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform logical and physical database modeling studio",
  "main": "app/desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "inspect:references": "python3 app/scripts/references/inventory.py"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.9.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
